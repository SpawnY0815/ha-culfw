{
  "name": "fht-schedule-card",
  "version": "0.3.1",
  "private": true,
  "description": "Week program card for the culfw integration",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
